type: generic.config.ocm.software/v1
configurations:
  - type: credentials.config.ocm.software
    consumers:
      - identity:
          type: RSA/v1alpha1
          algorithm: RSASSA-PSS
          signature: ${HOP}
        credentials:
          - type: Credentials/v1
            properties:
              private_key_pem_file: ${KEYS}/${HOP}-rsa.priv
              public_key_pem_file:  ${KEYS}/${HOP}-rsa.pub
